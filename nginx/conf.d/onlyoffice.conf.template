map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __ONLYOFFICE_DOMAIN__;

    ssl_certificate /etc/nginx/certs/origin.crt;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/cloudflare-realip.conf;

    # ONLYOFFICE wird von Nextcloud in einem domainübergreifenden iframe geladen.
    # Ein X-Frame-Options-SAMEORIGIN-Header würde den Editor blockieren.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header Content-Security-Policy "frame-ancestors 'self' https://__NEXTCLOUD_DOMAIN__" always;

    client_max_body_size __UPLOAD_LIMIT__;

    # Die öffentliche Hersteller-Welcome-Seite wird nicht ausgeliefert.
    location = / {
        default_type text/plain;
        return 404 "Not Found\n";
    }

    # Der technische Healthcheck bleibt für Nextcloud und Monitoring verfügbar.
    location = /healthcheck {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_pass http://onlyoffice:80;
    }

    # Editor, API, statische Ressourcen und WebSockets.
    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://onlyoffice:80;
    }
}
